# 00-board-check — configuração mínima versionada.
#
# Origem: examples/ESP-IDF/09_lvgl_v9_demo/sdkconfig.defaults
#   waveshareteam/ESP32-S3-Touch-LCD-7 @ bc51a84b30c0cea018fee6e0d7427ec10102060e
# Divergências em relação ao exemplo oficial estão marcadas com "DIVERGE".

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000

# Flash
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
# 8 MB, igual ao exemplo oficial e ao que esptool flash_id detectou nesta placa
# (JEDEC c8/4017). A página do produto fala em 16 MB: ver docs/hardware.md.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# PSRAM octal 8 MB (mesma configuração do exemplo oficial)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_RODATA=y
# DIVERGE: o exemplo desliga o teste de PSRAM no boot (CONFIG_SPIRAM_MEMTEST=n).
# Aqui fica no padrão do ESP-IDF (ligado) porque o objetivo é validar a placa.

# Cache (mesma configuração do exemplo oficial)
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# LVGL 9 (mesmos valores do exemplo oficial).
# Omitidos de propósito: CONFIG_EXAMPLE_LVGL_PORT_* (não usados pelo código),
# CONFIG_LV_USE_DEMO_WIDGETS (sem demo) e LV_MEMCPY_MEMSET_STD, LV_MEM_CUSTOM e
# LV_COLOR_SCREEN_TRANSP (símbolos da LVGL 8 que geram "unknown kconfig symbol").
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
# CONFIG_LV_USE_FONT_COMPRESSED is not set
# CONFIG_LV_USE_IMGFONT is not set
# CONFIG_LV_USE_LOG is not set
# CONFIG_LV_LOG_PRINTF is not set
# CONFIG_LV_USE_PERF_MONITOR is not set
